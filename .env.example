# Storage. Leave empty locally to use SQLite (recovery_desk.db).
DATABASE_URL=

# Model provider: "anthropic" or "openai_compat"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Only for openai_compat:
#   OpenRouter  https://openrouter.ai/api/v1      (pick a model that supports tools)
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
#   vLLM        http://<host>:8000/v1
LLM_BASE_URL=
# "native" uses the provider's tool calling; "json" asks the model for JSON tool calls (for models without tool support)
LLM_TOOL_MODE=native

# Basic sign-in for the demo (username is "desk"). Leave empty to disable.
APP_PASSWORD=

# Pin "today" for deadline maths in demos (YYYY-MM-DD). Empty = real date.
DESK_DATE=
