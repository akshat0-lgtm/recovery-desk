# Storage. Leave empty locally to use SQLite (recovery_desk.db).
DATABASE_URL=

# Model provider: "anthropic" or "openai_compat"
LLM_PROVIDER=openai_compat
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Only for openai_compat:
#   OpenRouter  https://openrouter.ai/api/v1      (pick a model that supports tools)
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
#   vLLM        http://<host>:8000/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
# "native" uses the provider's tool calling; "json" asks the model for JSON tool calls (for models without tool support)
LLM_TOOL_MODE=native
# Cap on output tokens per model call (lower it if your provider has a tight tokens-per-minute limit)
LLM_MAX_TOKENS=2500
# Per-stage model overrides, "stage=model,...". Defaults (Groq free tier): qwen for intake (0), build (3),
# negotiate (5); gpt-oss-120b for the rest. Set to an empty value to use LLM_MODEL everywhere.
# LLM_STAGE_MODELS=0=qwen/qwen3.8-27b,1=openai/gpt-oss-120b
# On a 429 a run switches to the next model in this comma list (each Groq model has its own limits).
LLM_FALLBACK_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# Client-side tokens-per-minute budget per model (Groq free tier is 8000). Calls wait instead of hitting 429s.
LLM_TPM_BUDGET=7000
# gpt-oss only: low | medium | high. Low saves output tokens.
LLM_REASONING_EFFORT=low

# Basic sign-in for the demo (username is "desk"). Leave empty to disable (default).
APP_PASSWORD=

# Pin "today" for deadline maths in demos (YYYY-MM-DD). Empty = real date.
DESK_DATE=
